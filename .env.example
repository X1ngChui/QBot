# Copy to .env. Credentials and infrastructure knobs live here; everything about the
# bot's behaviour is in config/settings.yaml.

# -- credentials -------------------------------------------------------------
# Named after the capability they serve, never after a platform: which platform answers
# a capability is set in config/settings.yaml (`capabilities.<capability>`). Docker Compose
# fails `up` when one is missing.

# Between the two containers only; any strong random string.
PG_PASSWORD=

# Replies, memory extraction, and vision (text and vision share one account).
TEXT_API_KEY=

# Embedding. Local CPU ASR has no credential.
MEDIA_API_KEY=

# Web search (a Tavily key, tvly-...).
SEARCH_API_KEY=

# -- infrastructure ----------------------------------------------------------

# Docker registry mirror. Leave as docker.io when you can pull directly.
REGISTRY=docker.io

# Build-time proxy, used only while building the image - never on the request path.
# Leave empty when the build host reaches deb.debian.org and pypi.org directly.
#
# Note this bites even on a host that looks fine: containers on the default bridge get no
# IPv6, so if the host only has IPv6 egress to a mirror, `curl` succeeds on the host and
# `apt-get` fails inside the build. Point this at an HTTP proxy the *container* can reach -
# for a proxy running on the host, that is the bridge gateway, not 127.0.0.1:
#
#     BUILD_PROXY=http://172.17.0.1:7890
BUILD_PROXY=
BUILD_NO_PROXY=localhost,127.0.0.1

# The QQ number NapCat logs in as. Leave empty for the very first login (it will show a QR),
# then set it so restarts and reboots log back in from the saved session instead of waiting
# for someone with a phone.
NAPCAT_ACCOUNT=
