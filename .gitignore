# Build output.
/target

# Deployment: real configuration, secrets and runtime data stay out of Git; only the examples
# and the secrets README are committed.
deploy/config/config.toml
deploy/config/conf.d/*.toml
deploy/config/personas/*.toml
deploy/config/locales/*.ftl
deploy/secrets/*
!deploy/secrets/README.md
deploy/data/*
!deploy/data/.gitkeep
deploy/.env

# Reply-quality evaluation reports.
eval/results/

# Local tool state.
.claude/
