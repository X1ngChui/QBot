# Copy to settings.yaml, then make it yours: owners, nicknames, models. The real
# settings.yaml stays out of version control (it names real accounts); everything
# structural about the file is documented here.
# Persona files in config/personas/group_<gid>.yaml may vary only the bot's identity
# and standing group context; behavior and resource settings in this file are global.
# The complete bundle is validated at startup and stays fixed for the process lifetime.
# Restart the process after changing settings, personas, prompts or predicates.
#
# Settings that wait on another setting are marked where they appear. A knob whose
# gate is shut does nothing at all - it is not doing a smaller version of its job.


# Everyone who holds the ops console (/help lists it) and receives the daily report,
# which arrives when the ledger day closes - see schedule.report_cron. QQ numbers, as
# strings.
owners: ["10001"]

# Local time for everything a person sees: the clock line in the prompt, the cron jobs, the
# daily report, and the day boundary the budget resets on. An IANA name, not an offset, so
# DST is handled where it applies.
timezone: "Asia/Shanghai"

trigger:
  # Every name people actually call the bot. Any one matching as a jieba token is a direct
  # mention - word-level, not substring.
  #
  # Note a nickname that is also an ordinary word will trip the must-answer path whenever
  # the group talks about that word. That is handled in the persona rather than in code:
  # the trigger fires, and the prompt tells the bot to shrug the mistake off in one line.
  # If it ever gets annoying, keep only the unambiguous names - @ still works.
  nicknames: ["小X", "小叉", "叉子"]

# Shutdown behavior for admitted background work.
gateway:
  # Seconds shutdown waits for in-flight media patches.
  shutdown_wait_sec: 5

media:
  # Seconds a reply waits for pending media resolution.
  wait_sec: 25
  # Seconds allowed for one NapCat media API call.
  protocol_timeout_sec: 10
  # Seconds allowed for one media download.
  http_timeout_sec: 20
  # Seconds before retrying media previously marked unreadable.
  unreadable_retry_sec: 600

members:
  # Seconds a fetched group member list remains fresh.
  cache_ttl_sec: 1800

commands:
  # Group roster entries rendered by one /members response.
  roster_max_entries: 60
  # Default and maximum spending rows rendered by /top.
  top_default_entries: 5
  top_max_entries: 20

identity_link:
  # Lifetime of a cross-account confirmation challenge created by /link.
  challenge_ttl_sec: 600
  # Global cap on durable pending challenges.
  max_pending_challenges: 1000
  # Pending challenges one initiating account may hold at once.
  max_pending_per_account: 3
  # Decimal digits in a newly issued confirmation code.
  challenge_code_length: 8

diagnostics:
  debug_max_rounds: 50
  log_tail_default_lines: 15
  log_tail_max_lines: 60
  log_tail_scan_bytes: 65536
  error_ring_entries: 200
  error_message_chars: 300
  daily_report_recent_errors: 8

tools:
  # Tool calls allowed in one model round.
  max_calls_per_round: 8
  # Maximum model rounds in one tool loop.
  max_rounds: 20
  send_messages:
    # Independent QQ messages allowed in one terminal tool call.
    max_messages_per_call: 4
    # Text characters allowed in each QQ message.
    max_text_chars_per_message: 2000
  web_search:
    # Results requested from one search.
    count: 5
    # Vendor search depth; advanced requests consume two credits.
    depth: basic
  search_history:
    # Archive lines included before and after each hit.
    context_lines: 5
    # Matching archive messages returned by one search.
    max_hits: 8
    # Terms accepted in one search expression.
    max_query_terms: 8
    # Characters returned by one search.
    max_result_chars: 12000
  recall_events:
    # Episodes included before and after each hit.
    context_episodes: 2
    # Similarity hits returned before temporal context is added.
    max_hits: 5
  read_url:
    # Page-text characters returned by one read.
    max_content_chars: 8000
  open_images:
    # Images accepted by one call.
    max_images: 6

# Five capabilities, each an independent provider with its own endpoint, model and
# credential, and no automatic fallback between them.
#
# This block is the only place a platform is named. The code above it deals in capabilities
# (text / vision / asr / embedding / search) and never learns who serves them, so
# retargeting one is an edit here and nothing else.
#
# `provider` is a closed value checked by the schema. Everything peculiar to a platform -
# prompt-cache accounting, reasoning controls and request extras - lives in its adapter, so
# upper layers only see capabilities and this file stays declarative.
#
# credential_env names a credential, it does not hold one; the value comes from .env
# (docker-compose injects it - see .env.example). text and vision share TEXT_API_KEY
# because one account serves both. Splitting them: new entry in .env and compose,
# new name here. A provider that runs in-process (local ASR) names no credential.
capabilities:
  # Retries for the plain-HTTP backends (embedding, search, file upload); the chat
  # backends use text.retries. And the longest a vendor's Retry-After may hold any
  # call - a vendor asking for minutes is asking the wrong client.
  http_retries: 2
  retry_after_cap_sec: 30
  text:
    provider: deepseek
    endpoint: https://api.deepseek.com
    credential_env: TEXT_API_KEY
    model: deepseek-flash
    # "low" keeps sanity-check thinking without paying the full deliberation
    # habit at output prices.
    reasoning_effort: low
    # The semaphore is built once at startup; restart to resize it without losing
    # outstanding permits.
    max_concurrency: 3
    timeout_sec: 30
    retries: 2
    # Reading transcript into memory is the other use of this model: same
    # account, same endpoint, its own task. Only what a task may change on
    # its own is here - endpoint, credential and concurrency describe the
    # account, and a second copy of an endpoint is how one goes stale.
    # Anything left out follows the reply settings above.
    extract:
    # The extractor resolves this policy once at startup. Any field left out inherits
    # the reply setting above it.
      # The one place a cheaper tier can measurably do the reply model's work,
      # because extraction is schema-guarded and eval-covered. Empty = the
      # reply model. Change this or the grade below, then re-run
      # scripts/eval_extract.py.
      model: ""
      # The schema and the Validator carry most of the thinking, but not all:
      # the counterintuitive rules travel with it, and alias reconfirmation
      # fails consistently at "off". So "low" is the floor.
      reasoning_effort: low
      # One call reads a whole chunk of transcript and answers with a dozen
      # tool calls, which is far slower than answering one line. Nobody is
      # waiting at 02:30, and a timeout costs the batch twice - once now and
      # once on the retry.
      timeout_sec: 120
  # Describing pictures for the archive. May be the same model the reply path uses,
  # but a separate capability all the same: descriptions are written at arrival for
  # every picture, including in groups the bot never answers in.
  vision:
    provider: deepseek
    endpoint: https://api.deepseek.com
    credential_env: TEXT_API_KEY
    model: deepseek-flash
    # Deliberation grade for the describing call: "low" buys meme-reading
    # judgement for a fraction of the vendor default's cost; "off" disables it.
    reasoning_effort: low
    # How long a stored description stays current. Past it, the next time that
    # picture is posted the bot pays to describe it again - models improve, and
    # a vendor can put a better model behind an unchanged id, which no model-id
    # stamp would notice. Refreshing is lazy: only a picture actually posted
    # again is looked up, so one nobody reposts is never paid for twice, and
    # transcript lines already archived keep the wording they were written
    # with. 0 disables expiry.
    description_ttl_days: 15
    # How long a stored file id (where the original was filed with the reply
    # model's backend) is trusted to still exist there; past it open_images
    # uploads the picture again. Keep it under the backend's retention (30 days
    # for DeepSeek).
    file_max_age_days: 20
    max_images_per_min: 6
    # Concurrent paid description calls across all groups.
    max_concurrency: 1
    # Shared reasoning and visible-output token ceiling for one description.
    max_output_tokens: 4096
    # Biggest picture worth handling, in MB. Bounds both halves of picture
    # handling: the download that feeds the description call, and the upload
    # that puts the original in front of the reply model.
    max_image_mb: 8
    timeout_sec: 30
  asr:
    # Fixed in-process SenseVoice CPU service. Download the model bundle once
    # with scripts/fetch_asr_model.sh; models/ is mounted read-only.
    # model_dir, threads, and queue_capacity require a restart.
    model_dir: /app/models/asr/sense-voice
    threads: 2
    queue_capacity: 8
    max_audio_sec: 300
    # Per-group admission guard in front of the global CPU queue.
    max_clips_per_min: 20
  embedding:
    provider: dashscope
    endpoint: https://dashscope.aliyuncs.com/compatible-mode/v1
    credential_env: MEDIA_API_KEY
    # Both are load-bearing beyond this file. dimensions must match the VECTOR(n)
    # column in sql/init.sql - a mismatch fails every insert. And vectors are stored
    # under the model that produced them and only ever searched under the current
    # one, so changing model hides every existing vector: recall_events comes back
    # empty until the nightly embed pass has rebuilt them.
    model: text-embedding-v4
    dimensions: 2048
    timeout_sec: 60
  search:
    provider: tavily
    endpoint: https://api.tavily.com
    credential_env: SEARCH_API_KEY
    # One total over every group.
    monthly_quota: 1000       # the free tier; at it search refuses, nothing bills
    # HTTP proxy for the search client only; model traffic stays direct. Empty
    # means direct. A proxy running on the deploy host is reached at the docker
    # bridge gateway as seen from inside the container - by default
    # http://172.17.0.1:7890.
    proxy: ""
    timeout_sec: 20

budget:
  # A real ceiling: at it the bot stops answering until the day rolls over in the
  # timezone above.
  # Only paid backends answer to it: free ones (sherpa transcription) pass
  # straight through, so their pace gates are the only thing holding them.
  # A total over every group against one shared ledger.
  daily_cny_cap: 3.0
  # What one reply may spend, in CNY, tool loop included. Money is the only
  # constraint: free tools run without limit, paid rounds account against this
  # figure. Reaching it stops the searching, not the reply - one tool-less
  # wrap-up round answers from what was already fetched. Only the daily cap
  # above, checked before anything is spent, means silence.
  per_reply_cny: 0.30

# What the model is shown of the conversation. Counts, not a token budget: money
# bounds what a reply may spend, and every other block is rendered whole.
prompt:
  # The history window, in chunks; it holds window_chunks * evict_chunk messages.
  # Whole chunks so the multiple holds by construction.
  window_chunks: 3
  # How many messages leave at once. A prefix cache matches from the start, so
  # every slide is a miss - sliding rarely is most of what there is to win.
  evict_chunk: 30
  # How much of a forwarded chat record is rendered into the message carrying
  # it: lines in all (nested records count towards the same total), how deep a
  # record inside a record is still expanded, and the characters the whole
  # block may take. Past any bound the rest is summarised as a count. Keep the
  # character bound under tools.send_messages.max_text_chars_per_message.
  forward_lines: 20
  forward_depth: 3
  forward_chars: 1500
  # Bounded evidence retained beside one reply for nearby follow-ups. It is structured,
  # rendered only when rebuilding a prompt, and deleted after the retention window.
  evidence_result_chars: 1200
  evidence_total_chars: 4000
  evidence_ttl_days: 30
  # Sanitized request summary retained in each evidence item.
  evidence_request_chars: 80

# How much the memory pipeline reads, and how fast it lets go. The model that runs
# extraction is not here - it belongs to the capability doing the work
# (capabilities.text.extract); this is the machinery around it.
memory:
  # The memory worker captures this whole block at construction; restart to apply edits.
  # Messages one extraction chunk holds at most.
  extract_window: 120
  # A full chunk is trimmed back to the last conversation gap of at least this many
  # minutes in its tail half, so batches end where conversations do.
  batch_gap_min: 30
  # Below this many unread messages a drain does not bother - a pass pays for the
  # rules and the schemas before reading a line.
  drain_floor: 20
  # Passes one nightly drain may run, and how many recorded episodes the extractor
  # is reminded of so it recognises what it already wrote down.
  max_passes: 10
  known_episodes: 8
  # Confirmed aliases shown beside one exact account in extraction context.
  roster_aliases_per_account: 4
  # Episodes older than this leave semantic recall. Their rows and source links stay
  # as history, while their rebuildable vector projections are removed.
  episode_ttl_days: 90
  # How long an unused name survives: one the model merely guessed at, and one it
  # marked as a joke. Most jokes are true for an afternoon.
  alias_unused_days: 30
  joke_unused_days: 7
  # How long a claimed memory job stays claimed. A full drain is several model calls
  # and can outlive a short lease; a deploy overlap would then pay twice.
  job_lease_min: 30
  # Idle polling, embedding page width, and queue retry delays in seconds.
  worker_idle_sec: 5
  embedding_page_size: 200
  worker_retry_backoff_sec: [60, 300, 1800, 3600]

schedule:
  # The scheduler registers this whole block once at startup.
  # The whole night is one pipeline in dependency order - extraction drain,
  # decay, pg_dump, napcat cache sweep - with a queue-drain wait between
  # stages (tasks.nightly). The report fires the moment the ledger day
  # closes, on the same midnight boundary the budget resets on.
  nightly_cron: "30 2 * * *"
  report_cron:  "0 0 * * *"
  backup_keep: 14
  napcat_cache_days: 7
  # How long the nightly pipeline waits for each stage's jobs to drain before moving
  # on anyway, and how often it checks. Moving on late beats a night with no backup.
  extract_drain_hours: 3
  decay_drain_min: 30
  drain_poll_sec: 30
  # How late a missed trigger may still fire. APScheduler's default is seconds, so a
  # loop busy at the trigger moment would silently skip that night.
  misfire_grace_sec: 3600
  # How old the newest dump may be before the daily report calls it out.
  backup_stale_hours: 26
  # Completed memory jobs older than this are pruned from the queue audit table.
  completed_job_keep_days: 30

# The connection pool. Small on purpose: one bot on one machine, and a pool larger
# than the work only moves contention into postgres.
database:
  # RESTART: the pool is built once at startup and never resized.
  pool_min: 2
  pool_max: 8
  # Ceiling on any single statement, so a query that will never finish fails instead
  # of holding a connection for the life of the process.
  command_timeout_sec: 20

# -- files --------------------------------------------------------------------
# Paths are relative to this config directory (absolute allowed).

# Per-group persona files (default.yaml + group_<gid>.yaml) live here.
personas_dir: personas

# Directory containing the versioned prompts.yaml bundle. Template keys, roles,
# roles and slots are fixed by prompting/templates.py; the whole bundle
# must validate before any of it loads. Wording rationale: prompts/README.md.
prompts_dir: prompts
# What may be recorded about a person, one entry per predicate (see the file).
predicates_file: predicates.yaml
