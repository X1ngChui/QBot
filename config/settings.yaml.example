# Copy to settings.yaml. Private settings and credentials must stay out of Git.
# All settings are global and loaded once. Restart after editing the bundle.
# Group persona files contain identity and standing context, not settings overrides.
# Optional fields and their defaults are documented in docs/configuration-reference.md.

bot:
  owners: ["10001"]
  timezone: Asia/Shanghai
  nicknames: ["小X", "小叉", "叉子"]

conversation:
  history_messages: 90
  max_messages_per_reply: 4
  # Covers admission waiting, media, model calls, tools, sends and observations.
  reply_deadline_sec: 180
  max_text_chars_per_message: 2000
  evidence_ttl_days: 30

backends:
  text:
    provider: deepseek
    endpoint: https://api.deepseek.com
    credential_env: TEXT_API_KEY
    model: deepseek-flash
    reasoning_effort: low
    max_concurrency: 3
    # Extraction shares this account; only task-specific choices differ.
    extract:
      reasoning_effort: low
      timeout_sec: 120
  vision:
    provider: deepseek
    endpoint: https://api.deepseek.com
    credential_env: TEXT_API_KEY
    model: deepseek-flash
    reasoning_effort: low
  asr:
    # Download with scripts/fetch_asr_model.sh; this fixed local service needs no key.
    model_dir: /app/models/asr/sense-voice
    threads: 2
  embedding:
    provider: dashscope
    endpoint: https://dashscope.aliyuncs.com/compatible-mode/v1
    credential_env: MEDIA_API_KEY
    model: text-embedding-v4
  search:
    provider: tavily
    endpoint: https://api.tavily.com
    credential_env: SEARCH_API_KEY
    monthly_quota: 1000
    # Applies only to search traffic; empty means direct.
    proxy: ""
    count: 5
    depth: basic

media:
  max_image_mb: 8
  max_audio_sec: 300
  max_images_per_min: 6
  max_clips_per_min: 20
  # Descriptions refresh lazily; zero disables age-based refresh.
  description_ttl_days: 15

memory:
  episode_ttl_days: 90
  alias_unused_days: 30
  temporary_alias_days: 7

budget:
  # Accounted-spend stop-loss, not a strict prepaid cap. Concurrent calls can overshoot.
  # Ledger failures stop new paid calls. Local ASR remains available.
  daily_cny_cap: 3.0
  per_reply_cny: 0.30

tasks:
  max_days_ahead: 30
  max_pending_per_group: 50
  max_chain_depth: 24
  max_executions_per_group_day: 24

maintenance:
  # APScheduler cron syntax in bot.timezone; use weekday names to avoid ambiguity.
  nightly_cron: "30 2 * * *"
  report_cron: "0 0 * * *"
  backup_keep: 14
  napcat_cache_days: 7
  completed_job_keep_days: 30
  completed_task_keep_days: 30

runtime:
  # Total active and queued addressed replies. Overload and expiry end silently.
  reply_capacity: 32
