# Per-group override example. Rename to group_<real gid>.yaml to activate (/reload picks it up).
# Only list the fields you override; everything else inherits default.yaml + settings.yaml.

name: 小X

system_prompt: |
  你是「小X」，这个群的一员。（此群专用的说话风格写这里）

group_knowledge: |
  群名：XXX
  梗：XXX 指的是 ……

overrides:
  trigger:
    # This group calls the bot by other names too - list every variant.
    nicknames: ["小X", "小叉", "叉子"]
