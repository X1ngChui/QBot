# Copy to config.toml (git-ignored). Only bot.account is required: the image carries complete
# defaults (`qbot print-defaults`), and a key set here overrides just that key. Per-environment
# drop-ins go in conf.d/*.toml (applied in file-name order, after this file); environment
# variables QBOT__SECTION__KEY win over all files.
#
# Credentials do not belong here. A `*_secret` key names a secret; the value comes from the
# environment or a file in /run/secrets.

[bot]
# The bot's own QQ account.
account = 10000
# May use owner commands and receive the daily report; cannot be blocked.
owners = [10001]
# Names that address the bot as a whole word, besides an @ and quoting one of its messages.
nicknames = ["Bobo"]
timezone = "Asia/Shanghai"
# en or zh-CN (built in), or a catalog in locales/. It also sets the language the bot writes its
# memory and picture descriptions in.
locale = "en"

# NapCat connects to ws://qbot:6199/onebot/v11/ws with the token in secrets/onebot_access_token.
# [gateway]
# listen = "0.0.0.0:6199"

# Describe pictures with a vision model (DeepSeek by default; for an OpenAI-style model set
# kind = "openai_responses" with its endpoint and model). Needs secrets/vision_api_key and a
# `vision_api_key` entry under `secrets:` in the compose file.
# [providers.vision]
# enabled = true

# Web search and page reading through Tavily. Needs secrets/search_api_key and a
# `search_api_key` entry under `secrets:` in the compose file.
# [providers.search]
# enabled = true

# An outbound proxy, for providers this host cannot reach directly; list the services that need
# it (text, vision, embedding, search, media). The others connect directly.
# [network]
# proxy = "http://172.17.0.1:7890"
# proxy_for = ["search"]

# Voice clips are transcribed in the process: run deploy/fetch_asr_model.sh once, or switch it
# off to leave clips as bare markers.
# [media]
# transcribe_voice = false

# How much chat a reply sees, in batches of lines (also the unit memory is built in).
# [history]
# batch_lines = 30
# raw_batches = 4
# summary_batches = 9

# [maintenance]
# nightly_cron = "30 2 * * *"
# report_cron = "0 0 * * *"
# backups = 14

# [database]
# host = "db.internal.example.com"   # an external server instead of the compose service
# ssl_mode = "require"
